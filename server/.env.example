# Required on Vercel (set in Project Settings > Environment Variables)
DATABASE_URL=postgres://user:password@host:5432/videoshare?sslmode=require

# --- Video storage: Cloudflare R2 -------------------------------------------
# Required on Vercel. Set all five, or none at all (none = save to local disk,
# which is what the classroom LAN and Docker setups use).
R2_ACCOUNT_ID=1234567890abcdef1234567890abcdef
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=video-sharing-uploads
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Only needed to delete videos uploaded before the move to R2. Those files still
# live in Vercel Blob; without this token they simply stay there.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Optional: comma-separated frontend origins allowed by CORS
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Optional: HMAC secret for direct upload tokens (defaults to hash of DATABASE_URL)
# UPLOAD_TOKEN_SECRET=your-random-secret
